---
const title = 'Singapore–Hong Kong Capital Migration | BondStats';
const description = 'A live evidence ledger testing whether financial activity is shifting between Hong Kong and Singapore using official banking and cross-border data.';
const canonical = 'https://www.bondstats.org/markets/singapore-hong-kong-capital-migration/';
const dataUrl = 'https://botapi33.github.io/bondstats-singapore-hong-kong-capital-migration/output/latest.json';
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:'Singapore–Hong Kong Capital Migration',applicationCategory:'FinanceApplication',operatingSystem:'Any',url:canonical,description,creator:{'@type':'Organization',name:'BondStats Ltd',url:'https://www.bondstats.org/'},dateModified:'2026-09-18'};
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><meta name="description" content={description}><meta name="robots" content="index,follow,max-image-preview:large"><link rel="canonical" href={canonical}><link rel="alternate" type="application/rss+xml" title="BondStats RSS Feed" href="https://www.bondstats.org/feed.xml"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}><meta property="og:type" content="website"><script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<style>
:root{color-scheme:dark;--ink:#e9f2ed;--muted:#84958d;--paper:#050807;--sheet:#0b100e;--line:#28322e;--signal:#68e2a9;--warm:#d8c99d;--bad:#e7837b}*{box-sizing:border-box}html{background:var(--paper)}body{margin:0;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:linear-gradient(90deg,#050807 0 49.95%,#070b09 50.05%)}a{color:inherit}.mast{height:48px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 26px;font:700 10px ui-monospace,SFMono-Regular,monospace;letter-spacing:.13em;text-transform:uppercase}.brand{color:var(--signal)}.live{display:flex;gap:8px;align-items:center;color:var(--muted)}.dot{width:6px;height:6px;border-radius:50%;background:var(--signal);box-shadow:0 0 12px var(--signal)}main{max-width:1500px;margin:auto;padding:0 26px 90px}.opening{display:grid;grid-template-columns:270px 1fr 290px;min-height:300px;border-bottom:1px solid var(--line)}.opening>div{padding:38px 24px}.opening>div:first-child{padding-left:0;border-right:1px solid var(--line)}.opening>div:last-child{padding-right:0;border-left:1px solid var(--line)}.kicker,.micro{font:700 9px ui-monospace,SFMono-Regular,monospace;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}.issue{font:500 19px/1.35 Georgia,serif;margin-top:60px;color:#c9d4ce}.question{display:flex;flex-direction:column;justify-content:center}.question h1{font:500 clamp(30px,4.2vw,63px)/1.03 Georgia,serif;letter-spacing:-.035em;margin:10px 0 18px;max-width:850px}.question p{max-width:760px;color:#a6b5ae;line-height:1.65;margin:0;font-size:15px}.verdict{display:flex;flex-direction:column;justify-content:center}.verdict strong{font:500 27px/1.15 Georgia,serif;margin:12px 0}.verdict p{font-size:11px;line-height:1.55;color:var(--muted)}.ledger-title{display:flex;justify-content:space-between;align-items:end;padding:34px 0 13px}.ledger-title h2{font:500 22px Georgia,serif;margin:0}.ledger-title span{color:var(--muted);font-size:11px}.balance{display:grid;grid-template-columns:1fr 74px 1fr;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.side{padding:28px 0}.side.sg{text-align:right;padding-right:34px}.side.hk{padding-left:34px}.side-name{font:500 clamp(28px,4vw,52px) Georgia,serif}.score{font:500 clamp(65px,9vw,126px)/.9 Georgia,serif;letter-spacing:-.06em;margin:14px 0}.sg .score{color:var(--signal)}.axis{position:relative;border-left:1px solid var(--line);border-right:1px solid var(--line);display:flex;justify-content:center;align-items:center}.axis:after{content:"50";font:700 9px ui-monospace,monospace;color:var(--muted);background:var(--paper);padding:6px}.caption{font-size:11px;color:var(--muted);line-height:1.5}.tape{border-bottom:1px solid var(--line)}.row{display:grid;grid-template-columns:190px 1fr 1fr 150px;min-height:72px;border-top:1px solid #171e1b;align-items:center}.row>div{padding:15px 14px}.row>div:first-child{padding-left:0}.row>div:last-child{padding-right:0;text-align:right}.row .name{font:700 10px ui-monospace,monospace;letter-spacing:.07em;text-transform:uppercase}.obs{font-size:12px;color:#b1beb8}.state{font:700 9px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.08em}.positive{color:var(--signal)}.negative{color:var(--bad)}.neutral{color:var(--warm)}.lower{display:grid;grid-template-columns:1.3fr .7fr;gap:0;border-bottom:1px solid var(--line)}.history{padding:36px 34px 36px 0;border-right:1px solid var(--line)}.history h2,.notes h2{font:500 22px Georgia,serif;margin:0 0 9px}.history p,.notes p{color:var(--muted);font-size:11px;line-height:1.6}.chart{height:250px;margin-top:25px;position:relative}.chart svg{width:100%;height:100%;overflow:visible}.notes{padding:36px 0 36px 34px}.stat{display:grid;grid-template-columns:1fr auto;border-top:1px solid var(--line);padding:13px 0;font-size:12px}.stat b{font-weight:500}.stat span{font:700 11px ui-monospace,monospace;color:var(--signal)}.evidence{padding-top:38px}.evidence-head{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-bottom:20px}.evidence h2{font:500 27px Georgia,serif;margin:0}.evidence-head p{color:var(--muted);font-size:12px;line-height:1.65;margin:0}.sources{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.source{padding:21px;border-right:1px solid var(--line)}.source:first-child{padding-left:0}.source:last-child{border-right:0;padding-right:0}.source b{font:500 16px Georgia,serif}.source p{color:var(--muted);font-size:11px;line-height:1.55;min-height:52px}.source a{color:var(--signal);text-decoration:none;font:700 9px ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase}.method{max-width:1000px;margin-top:28px;color:#94a49c;font-size:12px;line-height:1.8}.method strong{color:var(--ink)}footer{margin-top:46px;padding-top:16px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;color:#65736c;font-size:10px;line-height:1.5}@media(max-width:900px){.opening{grid-template-columns:1fr}.opening>div{padding:24px 0!important;border:0!important;border-bottom:1px solid var(--line)!important}.issue{margin-top:16px}.balance{grid-template-columns:1fr 44px 1fr}.row{grid-template-columns:1fr 1fr}.row>div:nth-child(3),.row>div:nth-child(4){border-top:1px solid #171e1b}.lower{grid-template-columns:1fr}.history{border-right:0;padding-right:0}.notes{padding-left:0;border-top:1px solid var(--line)}.sources{grid-template-columns:1fr}.source{border-right:0;border-bottom:1px solid var(--line);padding:18px 0}.evidence-head{grid-template-columns:1fr}}@media(max-width:560px){main{padding-left:17px;padding-right:17px}.mast{padding:0 17px}.balance{grid-template-columns:1fr}.axis{height:34px;border:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.side.sg{text-align:left;padding-right:0}.side.hk{padding-left:0}.row{grid-template-columns:1fr}.row>div{padding-left:0!important;text-align:left!important}.score{font-size:70px}footer{display:block}}
</style></head><body><header class="mast"><div class="brand">BondStats / Asia</div><div class="live"><span class="dot"></span><span id="statusline">Live evidence ledger</span></div></header><main>
<section class="opening"><div><div class="kicker">Research question · 01</div><div class="issue">A claim repeated across Asian finance — tested against the balance sheets rather than the headlines.</div></div><div class="question"><div class="micro">Singapore ↔ Hong Kong / Capital Migration</div><h1>Is financial activity actually shifting?</h1><p>BondStats compares relative banking and cross-border momentum across the two centres. It does not assume that every divergence is migration, and it does not manufacture a verdict when the official evidence is incomplete.</p></div><div class="verdict"><div class="micro">Evidence state</div><strong id="verdict">Synchronising…</strong><p id="asof">Waiting for the latest official-data run.</p></div></section>
<div class="ledger-title"><h2>The balance of evidence</h2><span>50 = neutral · directional, not predictive</span></div><section class="balance"><div class="side sg"><div class="micro">Singapore</div><div class="side-name">Destination pull</div><div class="score" id="sgScore">—</div><div class="caption">Relative evidence balance</div></div><div class="axis"></div><div class="side hk"><div class="micro">Hong Kong</div><div class="side-name">Counterweight</div><div class="score" id="hkScore">—</div><div class="caption">Mirror evidence balance</div></div></section>
<div class="ledger-title"><h2>Evidence tape</h2><span>Independent tests before a directional reading</span></div><section class="tape"><div class="row"><div class="name">Banking divergence</div><div class="obs" id="t1sg">Singapore —</div><div class="obs" id="t1hk">Hong Kong —</div><div class="state neutral" id="t1">Waiting</div></div><div class="row"><div class="name">Cross-border confirmation</div><div class="obs" id="t2sg">Singapore —</div><div class="obs" id="t2hk">Hong Kong —</div><div class="state neutral" id="t2">Waiting</div></div><div class="row"><div class="name">Persistence</div><div class="obs">3-month direction</div><div class="obs">12-month direction</div><div class="state neutral" id="t3">Waiting</div></div><div class="row"><div class="name">Multi-channel agreement</div><div class="obs">Independent signals</div><div class="obs">No single-series verdict</div><div class="state neutral" id="t4">Waiting</div></div></section>
<section class="lower"><div class="history"><h2>Evidence path</h2><p>Historical movement of the Singapore-side evidence balance. The centre line is neutral.</p><div class="chart"><svg id="chart" viewBox="0 0 1000 230" preserveAspectRatio="none"></svg></div></div><aside class="notes"><h2>Reading the signal</h2><p>The engine separates availability from conviction. A dramatic number with weak coverage remains weak evidence.</p><div class="stat"><b>Banking channel</b><span id="banking">—</span></div><div class="stat"><b>Cross-border channel</b><span id="crossborder">—</span></div><div class="stat"><b>Persistence</b><span id="persistence">—</span></div><div class="stat"><b>Confidence</b><span id="confidence">—</span></div><div class="stat"><b>Coverage</b><span id="coverage">—</span></div></aside></section>
<section class="evidence"><div class="evidence-head"><h2>What sits behind the reading</h2><p>Official aggregate data can reveal relative financial-system momentum, but cannot identify the beneficial owner or motivation of every flow. The tool therefore tests evidence consistent with migration — not proof that a specific dollar moved from Hong Kong to Singapore.</p></div><div class="sources"><div class="source"><b>Singapore · MAS / SingStat</b><p>Contains information from the Singapore banking dataset made available through data.gov.sg under the Singapore Open Data Licence. BondStats independently transforms the source observations into comparative indicators.</p><a href="https://data.gov.sg/datasets/d_f357c61441e2850ca4eae05813ebd37b/view" rel="noopener noreferrer">Official dataset ↗</a> · <a href="https://data.gov.sg/open-data-licence" rel="noopener noreferrer">Open Data Licence ↗</a></div><div class="source"><b>Hong Kong · HKMA</b><p>Contains information retrieved through the Hong Kong Monetary Authority Open API. Source information remains subject to the HKMA Terms and Conditions of Use and is independently analysed by BondStats.</p><a href="https://api.hkma.gov.hk/public/market-data-and-statistics/monthly-statistical-bulletin/financial/banking-statistics" rel="noopener noreferrer">Official API ↗</a> · <a href="https://www.hkma.gov.hk/eng/other-information/terms-and-conditions/" rel="noopener noreferrer">HKMA Terms ↗</a></div></div><div class="method"><strong>Methodology.</strong> Changes are transformed into comparable rates rather than comparing SGD and HKD levels. Banking and cross-border components are assessed independently. A directional state requires adequate coverage, persistence and agreement across channels. Missing observations stay missing; they are not estimated merely to force a result.<br/><br/><strong>Data rights & independence.</strong> BondStats is an independent service and is not affiliated with, sponsored by or endorsed by the Singapore Government, MAS, SingStat or HKMA. Source names are used solely for attribution. No source logos, proprietary charts or copied editorial material are used. Source data and APIs remain subject to their respective terms, licences and disclaimers. BondStats calculations, classifications, visualisations and methodology are independently produced and should not be interpreted as official source-provider conclusions.</div></section>
<footer><span>BondStats Ltd · Asian Capital Intelligence · Research tool, not investment advice.</span><span>Engine update: <span id="generated">—</span></span></footer>
</main><script define:vars={{ dataUrl }}>
const $=id=>document.getElementById(id);const pct=v=>Number.isFinite(v)?`${v>0?'+':''}${v.toFixed(2)}%`:'—';
function paint(el,s){if(!el)return;el.textContent=s?.label||'Unresolved';el.className='state '+(s?.class||'neutral')}
function draw(hist){const svg=$('chart');const h=(hist||[]).filter(x=>Number.isFinite(x.score));if(!h.length){svg.innerHTML='<text x="10" y="118" fill="#84958d" font-size="12">History will appear after sufficient official observations are synchronized.</text>';return}const pts=h.map((x,i)=>`${10+i*(980/Math.max(1,h.length-1))},${210-(x.score/100)*190}`).join(' ');svg.innerHTML=`<line x1="10" y1="115" x2="990" y2="115" stroke="#28322e" stroke-dasharray="4 7"/><polyline points="${pts}" fill="none" stroke="#68e2a9" stroke-width="2" vector-effect="non-scaling-stroke"/><text x="10" y="108" fill="#84958d" font-size="10">50 / neutral</text><text x="10" y="228" fill="#84958d" font-size="10">${h[0]?.period||''}</text><text x="920" y="228" fill="#84958d" font-size="10">${h.at(-1)?.period||''}</text>`}
async function load(){try{const r=await fetch(dataUrl+'?v='+Date.now(),{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();$('verdict').textContent=d.verdict?.label||'Insufficient evidence';$('asof').textContent=`Evidence through ${d.as_of||'—'}. ${d.verdict?.note||''}`;$('sgScore').textContent=Number.isFinite(d.singapore_score)?Math.round(d.singapore_score):'—';$('hkScore').textContent=Number.isFinite(d.hong_kong_score)?Math.round(d.hong_kong_score):'—';$('banking').textContent=d.channels?.banking?.label||'—';$('crossborder').textContent=d.channels?.crossborder?.label||'—';$('persistence').textContent=d.channels?.persistence?.label||'—';$('confidence').textContent=Number.isFinite(d.confidence)?d.confidence+'%':'—';$('coverage').textContent=Number.isFinite(d.coverage)?d.coverage+' / 4':'—';(d.tests||[]).slice(0,4).forEach((s,i)=>paint($('t'+(i+1)),s));$('t1sg').textContent='Singapore '+pct(d.raw?.sg_banking_3m);$('t1hk').textContent='Hong Kong '+pct(d.raw?.hk_banking_3m);$('t2sg').textContent='Singapore '+pct(d.raw?.sg_crossborder_3m);$('t2hk').textContent='Hong Kong '+pct(d.raw?.hk_crossborder_3m);$('generated').textContent=d.generated_at||'—';$('statusline').textContent='Official data synchronized';draw(d.history)}catch(e){$('verdict').textContent='Data sync unavailable';$('asof').textContent='No directional conclusion is displayed while the evidence feed is unavailable.';$('statusline').textContent='Evidence feed unavailable';draw([])}}load();
</script></body></html>
