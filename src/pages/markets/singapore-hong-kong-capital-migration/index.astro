---
const title = 'Singapore–Hong Kong Capital Migration Tracker | BondStats';
const description = 'An evidence engine testing whether financial activity is shifting between Hong Kong and Singapore using official banking and cross-border data.';
const canonical = 'https://www.bondstats.org/markets/singapore-hong-kong-capital-migration/';
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:'Singapore–Hong Kong Capital Migration Tracker',applicationCategory:'FinanceApplication',operatingSystem:'Any',url:canonical,description,creator:{'@type':'Organization',name:'BondStats Ltd',url:'https://www.bondstats.org/'},dateModified:'2026-09-18'};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><meta name="description" content={description}><meta name="robots" content="index,follow,max-image-preview:large"><link rel="canonical" href={canonical}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}><meta property="og:type" content="website"><script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<style>
:root{color-scheme:dark;--bg:#030706;--panel:#07100d;--line:#17352b;--text:#eef7f2;--muted:#8da39a;--green:#61e6aa;--amber:#e6c66b;--red:#e88982}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 72% 0,#10221a 0,#030706 38%);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}main{max-width:1450px;margin:auto;padding:58px 28px 100px}.eyebrow,.label{font:700 10px ui-monospace,monospace;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}.eyebrow{color:var(--green)}h1{font:500 clamp(48px,7vw,98px)/.91 Georgia,serif;letter-spacing:-.055em;margin:15px 0 23px}.hero{display:grid;grid-template-columns:1.45fr .55fr;gap:45px;border-bottom:1px solid var(--line);padding-bottom:34px}.lead{max-width:900px;color:#b7c8c0;font-size:18px;line-height:1.7}.signal{align-self:end;border-left:1px solid var(--line);padding-left:26px}.signal strong{display:block;font:500 31px Georgia,serif;margin:9px 0}.signal p,.fine{color:var(--muted);font-size:12px;line-height:1.6}.arena{display:grid;grid-template-columns:1fr 110px 1fr;border:1px solid var(--line);margin-top:30px;background:rgba(7,16,13,.86)}.city{padding:28px}.city h2{font:500 39px Georgia,serif;margin:7px 0}.score{font:500 clamp(45px,6vw,75px) Georgia,serif;margin:23px 0 2px}.bridge{display:flex;align-items:center;justify-content:center;border-left:1px solid var(--line);border-right:1px solid var(--line);position:relative}.bridge:before{content:"";position:absolute;width:100%;height:1px;background:linear-gradient(90deg,transparent,var(--green),transparent)}.bridge span{z-index:1;background:var(--bg);padding:7px;color:var(--green);font:700 9px ui-monospace,monospace;letter-spacing:.12em;writing-mode:vertical-rl}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:9px}.metric{border:1px solid var(--line);background:var(--panel);padding:18px;min-height:165px}.metric .value{font:500 27px Georgia,serif;margin:13px 0 7px}.metric .delta{font:700 10px ui-monospace,monospace;color:var(--green)}.section{margin-top:45px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:15px}.section h2{font:500 31px Georgia,serif;margin:0}.section-head p{max-width:690px;color:var(--muted);font-size:13px;line-height:1.6;margin:0}.test{display:grid;grid-template-columns:220px 1fr 1fr 160px;border-top:1px solid var(--line)}.test>div{padding:15px 13px;border-bottom:1px solid var(--line)}.test .sg,.test .hk{font-size:12px;color:#b7c8c0}.state{font:700 10px ui-monospace,monospace;letter-spacing:.07em;text-transform:uppercase}.positive{color:var(--green)}.negative{color:var(--red)}.neutral{color:var(--amber)}.chart{height:230px;border:1px solid var(--line);background:#06100c;padding:12px}.chart svg{width:100%;height:100%}.chart text{fill:var(--muted);font-size:10px}.sources{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.source{border:1px solid var(--line);background:#06100c;padding:19px}.source b{display:block;margin-bottom:7px}.source p{color:var(--muted);font-size:12px;line-height:1.55}.source a{color:var(--green);text-decoration:none;font-size:11px}.method{border:1px solid var(--line);padding:22px;margin-top:9px;color:#9db0a7;font-size:13px;line-height:1.75}.method strong{color:var(--text)}.foot{margin-top:42px;padding-top:18px;border-top:1px solid var(--line);color:#74877e;font-size:11px;line-height:1.6}.fresh{display:inline-block;padding:4px 7px;border:1px solid #24493b;color:#a8c6ba;font:700 9px ui-monospace,monospace;letter-spacing:.08em}@media(max-width:900px){.hero{grid-template-columns:1fr}.signal{border-left:0;padding-left:0}.arena{grid-template-columns:1fr}.bridge{height:62px;border:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.bridge:before{width:1px;height:100%}.bridge span{writing-mode:horizontal-tb}.grid,.sources{grid-template-columns:1fr 1fr}.test{grid-template-columns:1fr}.section-head{display:block}}@media(max-width:580px){.grid,.sources{grid-template-columns:1fr}}
</style></head><body><main>
<section class="hero"><div><div class="eyebrow">BondStats · Asian Capital Intelligence</div><h1>Is money leaving Hong Kong for Singapore?</h1><p class="lead">The claim is repeated constantly. The evidence is usually fragmented. This engine compares official banking-system momentum and cross-border balance-sheet activity, then asks whether Singapore is strengthening <em>relative</em> to Hong Kong across more than one independent channel.</p></div><div class="signal"><div class="label">Current evidence state</div><strong id="verdict">Loading official data…</strong><p id="asof">The engine never converts one observation into a migration claim.</p><span class="fresh" id="fresh">AUTO-UPDATED</span></div></section>
<section class="arena"><div class="city"><div class="label">Relative destination evidence</div><h2>Singapore</h2><div class="score" id="sgScore">—</div><div class="fine">0–100 evidence balance · 50 = neutral</div></div><div class="bridge"><span>MIGRATION EVIDENCE</span></div><div class="city"><div class="label">Relative rival evidence</div><h2>Hong Kong</h2><div class="score" id="hkScore">—</div><div class="fine">Mirror evidence balance · not a market forecast</div></div></section>
<div class="grid"><div class="metric"><div class="label">Banking pull</div><div class="value" id="banking">—</div><div class="delta" id="bankingD">—</div><div class="fine">Relative momentum in banking-system assets / deposits.</div></div><div class="metric"><div class="label">Cross-border pull</div><div class="value" id="crossborder">—</div><div class="delta" id="crossD">—</div><div class="fine">External claims and liabilities / BIS-compatible international activity.</div></div><div class="metric"><div class="label">Persistence</div><div class="value" id="persistence">—</div><div class="delta" id="persistD">—</div><div class="fine">Tests whether the relative move survives more than one observation window.</div></div><div class="metric"><div class="label">Confidence</div><div class="value" id="confidence">—</div><div class="delta" id="coverage">—</div><div class="fine">Coverage and agreement across available official observations.</div></div></div>
<section class="section"><div class="section-head"><h2>Relative evidence history</h2><p>Above 50 means the available evidence tilts toward Singapore; below 50 tilts toward Hong Kong. It is an evidence balance, not proof that the same capital moved from one centre to the other.</p></div><div class="chart"><svg id="chart" viewBox="0 0 1000 200" preserveAspectRatio="none"></svg></div></section>
<section class="section"><div class="section-head"><h2>The four-part migration test</h2><p>BondStats only publishes a directional migration state when independent channels agree and the movement persists. Mixed data remain mixed.</p></div><div class="test"><div><b>1 · Banking divergence</b></div><div class="sg" id="t1sg">Singapore banking momentum</div><div class="hk" id="t1hk">Hong Kong banking momentum</div><div class="state neutral" id="t1">Loading</div></div><div class="test"><div><b>2 · Cross-border confirmation</b></div><div class="sg" id="t2sg">Singapore external activity</div><div class="hk" id="t2hk">Hong Kong external activity</div><div class="state neutral" id="t2">Loading</div></div><div class="test"><div><b>3 · Persistence</b></div><div class="sg">3-month relative direction</div><div class="hk">12-month relative direction</div><div class="state neutral" id="t3">Loading</div></div><div class="test"><div><b>4 · Multi-channel agreement</b></div><div class="sg">Independent signals must agree</div><div class="hk">No single series can trigger the verdict</div><div class="state neutral" id="t4">Loading</div></div></section>
<section class="section"><div class="section-head"><h2>Primary evidence</h2><p>Automatic refresh uses public official datasets. Missing data are not filled with estimates merely to produce a signal.</p></div><div class="sources"><div class="source"><b>Singapore · MAS / SingStat</b><p>Commercial-bank assets and liabilities. The public dataset is sourced from the Monetary Authority of Singapore and updated monthly.</p><a href="https://data.gov.sg/datasets/d_f357c61441e2850ca4eae05813ebd37b/view" rel="noopener noreferrer">Official dataset ↗</a></div><div class="source"><b>Hong Kong · HKMA</b><p>Banking statistics including total assets, customer deposits, external claims and external liabilities through the HKMA Open API.</p><a href="https://api.hkma.gov.hk/public/market-data-and-statistics/monthly-statistical-bulletin/financial/banking-statistics" rel="noopener noreferrer">Official API ↗</a></div><div class="source"><b>Cross-check · BIS LBS</b><p>BIS locational banking statistics provide the common international-banking framework used to interpret cross-border movements.</p><a href="https://data.bis.org/topics/LBS/tables-and-dashboards/BIS%2CLBS_A5%2C1.0" rel="noopener noreferrer">BIS LBS ↗</a></div></div><div class="method"><strong>Method.</strong> The engine converts changes into comparable growth rates rather than comparing SGD and HKD levels. Banking and cross-border components are calculated independently; the relative Singapore-minus-Hong-Kong difference is bounded before aggregation. A directional state requires both adequate coverage and agreement across channels. Public aggregate statistics cannot identify the beneficial owner or motivation of every flow, so the result is deliberately described as <em>evidence consistent with migration</em>, never proof of a specific transfer.</div></section>
<div class="foot">BondStats Ltd · Singapore–Hong Kong Capital Migration Tracker · Research tool, not investment advice. Data-source revisions can change historical readings. Last engine update: <span id="generated">—</span>.</div>
</main><script>
const $=id=>document.getElementById(id); const pct=v=>Number.isFinite(v)?((v>0?'+':'')+v.toFixed(2)+'%'):'—';
function state(el,s){el.textContent=s.label||'Unresolved';el.className='state '+(s.class||'neutral')}
function chart(hist){const svg=$('chart'); if(!hist?.length){svg.innerHTML='<text x="20" y="105">History becomes available as official observations are synchronized.</text>';return} const vals=hist.map(x=>x.score).filter(Number.isFinite);if(!vals.length)return;const pts=hist.map((x,i)=>`${20+i*(960/Math.max(1,hist.length-1))},${180-(x.score/100)*160}`).join(' ');svg.innerHTML=`<line x1="20" y1="100" x2="980" y2="100" stroke="#24493b" stroke-dasharray="5 5"/><polyline points="${pts}" fill="none" stroke="#61e6aa" stroke-width="3" vector-effect="non-scaling-stroke"/><text x="22" y="94">50 neutral</text><text x="20" y="196">${hist[0]?.period||''}</text><text x="900" y="196">${hist.at(-1)?.period||''}</text>`}
async function load(){try{const r=await fetch('/data/singapore-hong-kong-capital-migration/latest.json?ts='+Date.now(),{cache:'no-store'});if(!r.ok)throw 0;const d=await r.json();$('verdict').textContent=d.verdict?.label||'Insufficient evidence';$('asof').textContent=`Evidence through ${d.as_of||'—'}. ${d.verdict?.note||''}`;$('sgScore').textContent=Number.isFinite(d.singapore_score)?d.singapore_score.toFixed(0)+'/100':'—';$('hkScore').textContent=Number.isFinite(d.hong_kong_score)?d.hong_kong_score.toFixed(0)+'/100':'—';$('banking').textContent=d.channels?.banking?.label||'—';$('bankingD').textContent=d.channels?.banking?.detail||'—';$('crossborder').textContent=d.channels?.crossborder?.label||'—';$('crossD').textContent=d.channels?.crossborder?.detail||'—';$('persistence').textContent=d.channels?.persistence?.label||'—';$('persistD').textContent=d.channels?.persistence?.detail||'—';$('confidence').textContent=(d.confidence??0)+'%';$('coverage').textContent=(d.coverage??0)+' of 4 tests available';(d.tests||[]).slice(0,4).forEach((s,i)=>state($('t'+(i+1)),s));$('t1sg').textContent='Singapore: '+pct(d.raw?.sg_banking_3m);$('t1hk').textContent='Hong Kong: '+pct(d.raw?.hk_banking_3m);$('t2sg').textContent='Singapore: '+pct(d.raw?.sg_crossborder_3m);$('t2hk').textContent='Hong Kong: '+pct(d.raw?.hk_crossborder_3m);$('generated').textContent=d.generated_at||'—';chart(d.history)}catch(e){$('verdict').textContent='Data sync unavailable';$('asof').textContent='No conclusion is shown while the official-data synchronization is unavailable.';chart([])}}load();
</script></body></html>