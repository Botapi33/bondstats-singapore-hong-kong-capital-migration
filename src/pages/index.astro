function rewriteHref(raw='') {
  if (!raw) return raw;
  if (/^(mailto:|tel:|#|javascript:)/i.test(raw)) return raw;

  // During preview, keep every known BondStats internal destination inside the
  // migration-baseline router. This covers source HTML links, relative routes,
  // and absolute www.bondstats.org links from older page generations.
  let candidate = raw;
  let suffix = '';
  try {
    if (/^https?:\/\//i.test(raw)) {
      const url = new URL(raw);
      if (!/(^|\.)bondstats\.org$/i.test(url.hostname)) return raw;
      candidate = url.pathname;
      suffix = `${url.search || ''}${url.hash || ''}`;
    } else {
      const cut = raw.search(/[?#]/);
      if (cut >= 0) { candidate = raw.slice(0, cut); suffix = raw.slice(cut); }
    }
  } catch { return raw; }

  const normalizedCandidatePath = String(candidate || '').toLowerCase().replace(/\s+/g, ' ').trim();
  const nativeTarget = nativeRouteAliases.get(normalizedCandidatePath);
  if (nativeTarget) return nativeTarget + suffix;
  if (validBaselineRoutes.has(candidate)) return publicHref(candidate) + suffix;
  const candidates = [candidate];
  try { candidates.push(decodeURIComponent(candidate)); } catch {}
  for (const c0 of candidates) {
    const c = c0.replace(/^\/+/, '');
    const base = c.split('/').filter(Boolean).pop() || '';
    if (sourceRouteMap[c0]) return publicHref(sourceRouteMap[c0]) + suffix;
    if (sourceRouteMap[c]) return publicHref(sourceRouteMap[c]) + suffix;
    if (sourceRouteMap[base]) return publicHref(sourceRouteMap[base]) + suffix;
    const cleanSlug = base.replace(/\.html?$/i,'').toLowerCase();
    if (baselineBySlug.has(cleanSlug)) return publicHref(baselineBySlug.get(cleanSlug)) + suffix;
    const alias = legacyRouteAliases.get(legacyRouteKey(c0));
    if (alias) return validBaselineRoutes.has(alias) ? publicHref(alias) + suffix : alias + suffix;
  }
  const finalAlias = legacyRouteAliases.get(legacyRouteKey(candidate));
  if (finalAlias) return validBaselineRoutes.has(finalAlias) ? publicHref(finalAlias) + suffix : finalAlias + suffix;
  return raw;
}

function rewriteHtml(input='') {
  if (!input) return input;
  return input.replace(/href=(['"])(.*?)\1/gi, (m,q,u) => `href=${q}${rewriteHref(u)}${q}`);
}


