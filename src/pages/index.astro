function navHref(link) {
  const raw = link?.href || '';
  if (!raw) return '';
  const titleKey = normalizeText(link?.text || '').toLowerCase();
  const rewritten = rewriteHref(raw);
  if (String(rewritten).startsWith('/migration-baseline/')) {
    const pathOnly = String(rewritten).split(/[?#]/)[0];
    if (validBaselineRoutes.has(pathOnly)) return rewritten;
  }
  if (/^(mailto:|tel:|#)/i.test(rewritten)) return rewritten;
  if (/^https?:/i.test(rewritten) && !/bondstats\.org/i.test(rewritten)) return rewritten;
  if (titleKey && navPageByTitle.has(titleKey)) return navPageByTitle.get(titleKey);
  const fallback = verifiedOriginalFallbacks[link?.text] || '';
  return rewriteHref(fallback);
}
function navCluster(routeSlug) {
  const p = navPageByRoute.get(routeSlug);
  if (!p) return [];
  const links = p.page_links || [];
  let end = links.length;
  for (let i=4;i<links.length;i++) {
    if (links[i]?.text === 'BondStats' && links[i]?.href === 'Home.html') { end = i; break; }
  }
  const body = links.slice(4,end);
  const seen = new Set();
  const out = [];
  for (const link of body) {
    const href = navHref(link);
    const text = normalizeText(link?.text || '');
    if (!text || !href) continue;
    const key = `${text}|${href}`;
    if (seen.has(key)) continue;
    seen.add(key);
    out.push({text,href});
  }
  return out;
}
