}

function normalizeText(value='') {
  return String(value).replace(/\s+/g,' ').trim();
}

function premiumHomeHeading(value='') {
  return normalizeText(value)
    .replace(/^[\p{Extended_Pictographic}\uFE0F\u200D\s]+/u,'')
    .replace(/^<\/>\s*/,'');
}

// Stage-2 extraction recorded nested <p> elements inside <li> twice.
// Keep the list item (which already contains the full original inner HTML)
// and suppress only the immediately-following extractor duplicate.
const dedupedBlocks = sourceBlocks.filter((block, index, arr) => {
  if (block.type !== 'p' || index === 0) return true;
  const prev = arr[index - 1];
  if (prev?.type !== 'li') return true;
  return normalizeText(prev.text) !== normalizeText(block.text);
});

// Final migration-tail cleanup requested after visual parity review.
// Remove only the two redundant metadata sections that were appended to a
// small subset of pages.  The actual article/tool content and Related block
// remain untouched.
function stripRedundantTailSections(input) {
  const out = [];
  let skip = null;
  for (const block of input) {
    const text = normalizeText(block.text || '');

    if (skip === 'about') {
      if (text === 'Data & Transparency') { skip = 'transparency'; continue; }
      if (text === 'Related Bond Market Tools and Pages') { skip = null; out.push(block); }
      continue;
    }
    if (skip === 'transparency') {
      if (text === 'Related Bond Market Tools and Pages') { skip = null; out.push(block); }
      continue;
    }

    if (text === 'About the Data') { skip = 'about'; continue; }
    if (text === 'Data & Transparency') { skip = 'transparency'; continue; }
    out.push(block);
  }
  return out;
}

const blocks = stripRedundantTailSections(dedupedBlocks);

