function legacyRouteKey(value='') {
  let s = String(value || '').trim();
  try { s = decodeURIComponent(s); } catch {}
  s = s.split(/[?#]/)[0].replace(/^https?:\/\/[^/]+/i,'');
  s = s.replace(/^\/migration-baseline\//i,'').replace(/^\/+|\/+$/g,'');
