      .nav-flyout{position:static!important;left:auto!important;top:auto!important;width:100%;max-height:none;overflow:visible;box-shadow:none;border:0;border-left:1px solid #34383e;background:#181a1e;margin:0 0 4px 10px;padding:4px 0}
