function publicHref(value='') {
  const raw = String(value || '');
  const [pathAndQuery, hash=''] = raw.split('#', 2);
  const qIndex = pathAndQuery.indexOf('?');
  let path = qIndex >= 0 ? pathAndQuery.slice(0, qIndex) : pathAndQuery;
  const query = qIndex >= 0 ? pathAndQuery.slice(qIndex) : '';
  try {
    if (/^https?:\/\//i.test(path)) path = new URL(path).pathname;
  } catch {}
  const normalizedBaseline = path.startsWith('/migration-baseline/') && !path.endsWith('/') ? `${path}/` : path;
  const mapped = cleanPublicByBaseline.get(path) || cleanPublicByBaseline.get(normalizedBaseline) || path;
  return mapped + query + (hash ? `#${hash}` : '');
}
function baselineRouteForHref(value='') {
