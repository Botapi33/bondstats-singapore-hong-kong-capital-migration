function isBrokenRegimeLinkBlock(block) {
  const t = normalizeText(block?.text || '');
  return block?.type === 'li' && t.startsWith('Bond Market Regime Monitor');
}

const homeFixedIncomeSeen = new Set();
const homeFixedIncomeBlocks = blocks.slice(21).filter((block) => {
  if (isBrokenRegimeLinkBlock(block)) return false;
  const text = normalizeText(block?.text || '');
  const label = normalizeText(text.split(/\s+[–—-]\s+/)[0] || text).toLowerCase();
  if (!label) return true;
  if (homeFixedIncomeSeen.has(label)) return false;
  homeFixedIncomeSeen.add(label);
  return true;
});

