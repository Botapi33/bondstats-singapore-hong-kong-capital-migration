function attrsFor(block) {
  const classes = Array.isArray(block.classes) ? [...block.classes] : [];
  const text = normalizeText(block.text || '');
  if (text === 'Related Bond Market Tools and Pages') classes.push('related-tools-heading');
  if (text === 'You can also explore related BondStats tools and pages:') classes.push('related-tools-intro');
  return {
    style: block.style || undefined,
    class: classes.length ? classes.join(' ') : undefined,
    'data-bs-source-type': block.type
